{
  "name": "business-record-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy:demo": "CLOUDFLARE_ENV=demo pnpm build && wrangler deploy",
    "deploy:production": "CLOUDFLARE_ENV=production pnpm build && wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:local": "node ./scripts/smoke-local.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply business-records-local --local --persist-to .wrangler/state",
    "db:seed:local": "wrangler d1 execute business-records-local --local --persist-to .wrangler/state --file ./scripts/seed-local.sql",
    "db:inspect:local": "wrangler d1 execute business-records-local --local --persist-to .wrangler/state --command \"SELECT key, value, updated_at FROM runtime_metadata ORDER BY key\"",
    "db:verify:local": "wrangler d1 execute business-records-local --local --persist-to .wrangler/state --file ./scripts/verify-schema.sql",
    "db:reset:local": "node ./scripts/reset-local.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.129.0"
  }
}
