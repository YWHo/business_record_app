{
  "name": "business-record-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "build:production": "tsc -b && vite build --mode cloudflare-production",
    "preview": "vite preview",
    "deploy:demo": "pnpm build:demo && wrangler deploy --env demo",
    "deploy:production": "pnpm build:production && wrangler deploy --env production",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:migrations": "node ./scripts/test-migration-regression.mjs",
    "test:demo-data": "node ./scripts/test-demo-seed.mjs",
    "test:local-data": "node ./scripts/test-local-showcase.mjs",
    "security:audit": "pnpm audit --audit-level moderate",
    "test:watch": "vitest",
    "test:e2e": "pnpm test:e2e:api && pnpm test:e2e:browser",
    "test:e2e:api": "pnpm db:reset:test && playwright test --grep @api-smoke",
    "test:e2e:browser": "pnpm db:reset:test && playwright test --grep-invert @api-smoke",
    "test:e2e:headed": "pnpm db:reset:test && playwright test --grep-invert @api-smoke --headed",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply business-records-local --local --persist-to .wrangler/state",
    "db:seed:local": "wrangler d1 execute business-records-local --local --persist-to .wrangler/state --file ./scripts/seed-local.sql && wrangler d1 execute business-records-local --local --persist-to .wrangler/state --file ./scripts/seed-local-showcase.sql",
    "db:seed:test": "wrangler d1 execute business-records-local --local --persist-to .wrangler/state --file ./scripts/seed-local.sql",
    "db:inspect:local": "wrangler d1 execute business-records-local --local --persist-to .wrangler/state --command \"SELECT key, value, updated_at FROM runtime_metadata ORDER BY key\"",
    "db:verify:local": "wrangler d1 execute business-records-local --local --persist-to .wrangler/state --file ./scripts/verify-schema.sql",
    "db:reset:local": "node ./scripts/reset-local.mjs",
    "db:reset:test": "node ./scripts/reset-local.mjs --test",
    "db:migrate:demo": "wrangler d1 migrations apply DB --remote --env demo",
    "db:seed:demo": "node ./scripts/manage-demo.mjs seed",
    "db:reset:demo": "node ./scripts/manage-demo.mjs reset",
    "db:verify:demo": "wrangler d1 execute DB --remote --env demo --file ./scripts/verify-demo.sql"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "storybook": "^10.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.145.0"
  }
}
