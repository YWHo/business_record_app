{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "business-records-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-07",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ENV": "local",
    "LOCAL_AUTH_ENABLED": "true",
    "DEV_OWNER_EMAIL": "owner@local.test",
    "DEV_ACCOUNTANT_EMAIL": "accountant@local.test",
    "DEV_BOOTSTRAP_KEY": "local-bootstrap-only",
    "APP_ORIGIN": "http://localhost:5173",
    "TURNSTILE_REQUIRED": "false",
    "TURNSTILE_SITE_KEY": "",
    "EMAIL_DELIVERY_URL": "",
    "EMAIL_FROM": "no-reply@local.test",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "business-records-local",
      "database_id": "11111111-1111-4111-8111-111111111111",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "business-records-local-documents",
    },
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "INVITE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "env": {
    "demo": {
      "name": "business-records-demo",
      "vars": {
        "APP_ENV": "demo",
        "LOCAL_AUTH_ENABLED": "false",
        "DEV_OWNER_EMAIL": "disabled@demo.invalid",
        "DEV_ACCOUNTANT_EMAIL": "disabled@demo.invalid",
        "DEV_BOOTSTRAP_KEY": "disabled",
        "APP_ORIGIN": "https://replace-with-demo.workers.dev",
        "TURNSTILE_REQUIRED": "false",
        "TURNSTILE_SITE_KEY": "",
        "EMAIL_DELIVERY_URL": "",
        "EMAIL_FROM": "no-reply@demo.invalid",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "business-records-demo",
          "database_id": "22222222-2222-4222-8222-222222222222",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "DOCUMENTS",
          "bucket_name": "business-records-demo-documents",
        },
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "INVITE_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
    "production": {
      "name": "business-records-production",
      "vars": {
        "APP_ENV": "production",
        "LOCAL_AUTH_ENABLED": "false",
        "DEV_OWNER_EMAIL": "disabled@production.invalid",
        "DEV_ACCOUNTANT_EMAIL": "disabled@production.invalid",
        "DEV_BOOTSTRAP_KEY": "disabled",
        "APP_ORIGIN": "https://replace-with-production.workers.dev",
        "TURNSTILE_REQUIRED": "true",
        "TURNSTILE_SITE_KEY": "replace-with-production-site-key",
        "EMAIL_DELIVERY_URL": "https://replace-with-email-relay.invalid/send",
        "EMAIL_FROM": "replace-with-sender@example.invalid",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "business-records-production",
          "database_id": "33333333-3333-4333-8333-333333333333",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "DOCUMENTS",
          "bucket_name": "business-records-production-documents",
        },
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "3001",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "INVITE_RATE_LIMITER",
          "namespace_id": "3002",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
  },
}
